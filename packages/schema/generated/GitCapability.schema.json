            "developer_tools_stub",
            "failed"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
